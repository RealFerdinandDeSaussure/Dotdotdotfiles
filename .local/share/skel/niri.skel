// %-LOCATION:$HOME/.config/niri/config.kdl-% -*-kdl-*-
// DO EDITS HERE: $HOME/.local/share/skel/niri.skel

include optional=true "custom.kdl"

// Input device configuration.
input {
    keyboard {
        xkb {
            file "~/.config/xkb/custom.xkb"
        }
        numlock
    }

    touchpad {
        // off
        // tap
        // dwt
        // dwtp
        // drag false
        // drag-lock
        // natural-scroll
        // accel-speed 0.2
        // accel-profile "flat"
        // scroll-method "two-finger"
        // disabled-on-external-mouse
    }

    mouse {
        // natural-scroll
        accel-profile "flat"
    }

}

// You can configure outputs by their name, which you can find
// by running `niri msg outputs` while inside a niri instance.
// The built-in laptop monitor is usually called "eDP-1".
// Find more information on the wiki:

// Settings that influence how windows are positioned and sized.
// Find more information on the wiki:
layout {
    gaps 12

    center-focused-column "never"

    preset-column-widths {
        proportion 0.5
        proportion 0.33333
        proportion 0.66667

    }

    default-column-width { proportion 0.5; }

    focus-ring {
        width 3
        active-gradient from="#{{{$__BASE0E}}}" to="#{{{$__BASE0D}}}" angle=67 in="oklch decreasing hue"
    }

    border {
        width 0
    }

    shadow {
        on
        softness 30
        spread 10
        offset x=2 y=5
        color "#{{{$__BASE00}}}77"
    }

    struts {
        left 6
        right 14
        top -4
        bottom -4
    }

}

// Animation settings.
animations {
}

// Gestures are functions that are activated by cursor movement
// For more info, see the wiki:
gestures {
    hot-corners {
        off
    }
}

// Named workspaces
workspace "󰖟"
workspace ""

// Window rules let you adjust behavior for individual windows.
// Find more information on the wiki:
window-rule {
    // enable rounded corners for all windows.
    geometry-corner-radius 2
    clip-to-geometry true
}

window-rule {
    // draw a red border around urgent windows
    match is-urgent=true
    border {
        width 4
        urgent-color "{{{$__BASE08}}}"
    }
}

window-rule {
    match is-floating=true
    focus-ring {
        width 2
        active-color "{{{$__BASE04}}}"
    }
}

window-rule {
    match app-id="emacs"
    exclude title="(?i)question"
    // open-maximized-to-edges true
    open-maximized true
    open-on-workspace ""
}

// Open the Firefox picture-in-picture player as floating by default.
window-rule {
    // This app-id regular expression will work for both:
    // - host Firefox (app-id is "firefox")
    // - Flatpak Firefox (app-id is "org.mozilla.firefox")
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}

window-rule {
    match app-id="org.qutebrowser.qutebrowser"
    // open-maximized-to-edges true
    open-maximized true
    open-on-workspace "󰖟"
}

window-rule {
    match app-id="(?i)pinentry.*"
    open-floating true
}

window-rule {
    match app-id="steam"
    open-maximized true
}

binds {
    // "Super" is a special modifier equal to Super when running on a TTY, and to Alt
    // when running as a winit window.

    Super+Return { spawn "{{{$TERMINAL}}}"; }
    Super+Ctrl+Return { spawn "~/.config/niri/scripts/open_in_column" "{{{$TERMINAL}}}"; }
    Super+R { spawn-sh "tofi-drun | xargs niri msg action spawn -- "; }

    // close notifications
    Super+Backspace { spawn "dunstctl" "close-all"; }
    Super+Shift+Backspace { spawn "dunstctl" "close"; }

    // reload all configs
    Super+Shift+R { spawn "fish" "-c" "merge-configs"; }

    XF86AudioRaiseVolume         allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    XF86AudioLowerVolume         allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    Shift+XF86AudioRaiseVolume   allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "1%+"; }
    Shift+XF86AudioLowerVolume   allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "1%-"; }
    XF86AudioMute                allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86AudioMicMute             allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }
    XF86MonBrightnessUp          allow-when-locked=true { spawn "brightnessctl" "s" "5%+"; }
    XF86MonBrightnessDown        allow-when-locked=true { spawn "brightnessctl" "s" "5%-"; }
    Shift+XF86MonBrightnessUp    allow-when-locked=true { spawn "brightnessctl" "s" "1%+"; }
    Shift+XF86MonBrightnessDown  allow-when-locked=true { spawn "brightnessctl" "s" "1%-"; }

    Super+O repeat=false { toggle-overview; }

    Super+Q { close-window; }

    Super+Left  { focus-column-left; }
    Super+Down  { focus-window-down; }
    Super+Up    { focus-window-up; }
    Super+Right { focus-column-right; }
    Super+H     { focus-column-left; }
    Super+J     { focus-window-down; }
    Super+K     { focus-window-up; }
    Super+L     { focus-column-right; }

    Super+Shift+Left  { move-column-left; }
    Super+Shift+Down  { move-window-down-or-to-workspace-down; }
    Super+Shift+Up    { move-window-up-or-to-workspace-up; }
    Super+Shift+Right { move-column-right; }
    Super+Shift+H     { move-column-left; }
    Super+Shift+J     { move-window-down; }
    Super+Shift+K     { move-window-up; }
    Super+Shift+L     { move-column-right; }

    Super+less          { focus-column-first; }
    Super+Y             { focus-column-last; }
    Super+Shift+less     { move-column-to-first; }
    Super+Shift+Y        { move-column-to-last; }

    // Super+Alt+Left  { focus-monitor-left; }
    // Super+Alt+Down  { focus-monitor-down; }
    // Super+Alt+Up    { focus-monitor-up; }
    // Super+Alt+Right { focus-monitor-right; }
    // Super+Alt+H     { focus-monitor-left; }
    // Super+Alt+J     { focus-monitor-down; }
    // Super+Alt+K     { focus-monitor-up; }
    // Super+Alt+L     { focus-monitor-right; }

    // Super+Alt+Shift+Left  { move-column-to-monitor-left; }
    // Super+Alt+Shift+Down  { move-column-to-monitor-down; }
    // Super+Alt+Shift+Up    { move-column-to-monitor-up; }
    // Super+Alt+Shift+Right { move-column-to-monitor-right; }
    // Super+Alt+Shift+H     { move-column-to-monitor-left; }
    // Super+Alt+Shift+J     { move-column-to-monitor-down; }
    // Super+Alt+Shift+K     { move-column-to-monitor-up; }
    // Super+Alt+Shift+L     { move-column-to-monitor-right; }

    Super+Page_Down      { focus-workspace-down; }
    Super+Page_Up        { focus-workspace-up; }
    Super+N              { focus-workspace-down; }
    Super+P              { focus-workspace-up; }
    Super+Shift+Page_Down { move-column-to-workspace-down; }
    Super+Shift+Page_Up   { move-column-to-workspace-up; }
    Super+Shift+N         { move-column-to-workspace-down; }
    Super+Shift+P         { move-column-to-workspace-up; }

    Super+Ctrl+Shift+Page_Down { move-workspace-down; }
    Super+Ctrl+Shift+Page_Up   { move-workspace-up; }
    Super+Ctrl+Shift+N         { move-workspace-down; }
    Super+Ctrl+Shift+P         { move-workspace-up; }

    Super+WheelScrollDown      cooldown-ms=150 { focus-workspace-down; }
    Super+WheelScrollUp        cooldown-ms=150 { focus-workspace-up; }
    Super+Shift+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Super+Shift+WheelScrollUp   cooldown-ms=150 { move-column-to-workspace-up; }

    Super+WheelScrollRight      { focus-column-right; }
    Super+WheelScrollLeft       { focus-column-left; }
    Super+Shift+WheelScrollRight { move-column-right; }
    Super+Shift+WheelScrollLeft  { move-column-left; }

    // Super+TouchpadScrollDown { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "0.02+"; }
    // Super+TouchpadScrollUp   { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "0.02-"; }

    Super+1 { focus-workspace 1; }
    Super+2 { focus-workspace 2; }
    Super+3 { focus-workspace 3; }
    Super+4 { focus-workspace 4; }
    Super+5 { focus-workspace 5; }
    Super+6 { focus-workspace 6; }
    Super+7 { focus-workspace 7; }
    Super+8 { focus-workspace 8; }
    Super+9 { focus-workspace 9; }
    Super+Shift+1 { move-column-to-workspace 1; }
    Super+Shift+2 { move-column-to-workspace 2; }
    Super+Shift+3 { move-column-to-workspace 3; }
    Super+Shift+4 { move-column-to-workspace 4; }
    Super+Shift+5 { move-column-to-workspace 5; }
    Super+Shift+6 { move-column-to-workspace 6; }
    Super+Shift+7 { move-column-to-workspace 7; }
    Super+Shift+8 { move-column-to-workspace 8; }
    Super+Shift+9 { move-column-to-workspace 9; }

    Super+Tab { focus-workspace-previous; }

    Super+Comma  { consume-window-into-column; }
    Super+Period { expel-window-from-column; }

    Super+S { switch-preset-column-width; }
    Super+V { switch-preset-window-height; }
    Super+Ctrl+J { reset-window-height; }
    Super+Ctrl+L { maximize-column; }
    Super+F { maximize-window-to-edges; }
    Super+Shift+F { fullscreen-window; }

    Super+C { center-column; }
    Super+Shift+C { center-visible-columns; }

    Super+Minus { set-column-width "-10%"; }
    Super+Plus { set-column-width "+10%"; }
    Super+Shift+Minus { set-window-height "-10%"; }
    Super+Shift+Equal { set-window-height "+10%"; }

    Super+T       { toggle-window-floating; }
    Super+Shift+T       { switch-focus-between-floating-and-tiling; }

    Super+W { toggle-column-tabbed-display; }

    Print { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }

    Super+F8 allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }

    Alt+Pause { power-off-monitors; }

    // mode-like keys with wlr-which-key
    Super+I { spawn "wlr-which-key" "--initial-keys=i"; }
    Super+M { spawn "wlr-which-key" "--initial-keys=m"; }
    Super+B { spawn "wlr-which-key" "--initial-keys=b"; }
    Super+Shift+I { spawn "wlr-which-key" "--initial-keys=x"; }
}

// And then all the options that do not fit into any of the existing categories
// For more information see the wiki:

prefer-no-csd
screenshot-path "~/Bilder/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

hotkey-overlay {
    skip-at-startup
}

cursor {
    hide-after-inactive-ms 9000
}

spawn-at-startup "ironbar"
spawn-at-startup "swaybg" "-i" "{{{$HOME}}}/Bilder/wallpaper.jpg" "--mode=fill"
spawn-at-startup "swayidle" "timeout" "300" "niri msg action power-off-monitors"
