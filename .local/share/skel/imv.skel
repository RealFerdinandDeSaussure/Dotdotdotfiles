# %-LOCATION:$HOME/.config/imv/config-% -*-conf-*-
# DO EDITS HERE: $HOME/.local/share/skel/imv.skel

[options]
# Suppress built-in key bindings, and specify them explicitly in this
# config file.
suppress_default_binds = true
overlay_font = Monospace:12
overlay_text = "[${imv_current_index}/${imv_file_count}] [${imv_width}x${imv_height}] - $(basename ${imv_current_file})"
overlay_text_color = {{{__BASE07}}}
overlay_background_color = {{{__BASE00}}}

[aliases]
# Define aliases here. Any arguments passed to an alias are appended to the
# command.
# alias = command to run

[binds]
# Define some key bindings
q = quit
# y = exec echo working!

# Image navigation
<Left> = prev
<Shift+K> = prev
<Right> = next
<Shift+J> = next
gg = goto 1
<Shift+G> = goto -1

# Panning
j = pan 0 -50
k = pan 0 50
h = pan 50 0
l = pan -50 0

# Zooming
<Up> = zoom 1
<Shift+plus> = zoom 1
i = zoom 1
<Shift+I> = zoom 8
<Down> = zoom -1
<minus> = zoom -1
o = zoom -1
<Shift+O> = zoom -8

# Rotate Clockwise by 90 degrees
r = rotate by 90
<Shift+R> = rotate by -90

# Other commands
x = close
f = fullscreen
d = overlay
p = exec echo "${imv_current_file}"
<Shift+P> = exec grep -qxF "${imv_current_file}" "$(dirname ${imv_current_file})/imv_select.tmp" 2>/dev/null || echo "${imv_current_file}" >> "$(dirname ${imv_current_file})/imv_select.tmp"
c = center
s = scaling next
<Shift+S> = upscaling next
a = zoom actual
e = reset
<Shift+X> = exec rm "${imv_current_file}" && imv-msg ${imv_pid} next

# Gif playback
<period> = next_frame
<space> = toggle_playing

# Slideshow control
t = slideshow +1
<Shift+T> = slideshow -1
