# %-LOCATION:$HOME/.config/pimsync/pimsync.conf-%
# DO EDITS HERE: $HOME/.local/share/skel/pimsync.skel

status_path ~/.local/share/pimsync/status/

storage cal_remote {
        type caldav
        url {
            cmd pass field url random/radicale
        }
        username {
            cmd pass field user random/radicale
        }
        password {
            shell pass show random/radicale | head -n1
        }
}

storage cal_local {
        type vdir/icalendar
        path ~/.local/share/pimsync/cal/
        fileext ics
}

pair calendars {
     storage_a cal_local
     storage_b cal_remote
     collections all
     conflict_resolution cmd nvim -d
}