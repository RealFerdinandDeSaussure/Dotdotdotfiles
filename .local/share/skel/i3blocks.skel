# %-LOCATION:$HOME/.config/i3blocks/config-% -*-conf-*-
# %-CUSTOM:$HOME/.config/i3blocks/custom-%
# DO EDITS HERE: $HOME/.local/share/skel/i3blocks.skel
# [global]
command=blocklets/${BLOCK_NAME}
separator_block_width=15
markup=pango

[wl-clipboard]
interval=persist

[mpd]
interval=persist
format=json
markup=none

# [custom]
{{{custom}}}

# end of custom settings
[caffeine]
signal=10
interval=once

[time]
interval=30
format=json
_BLOCK_STATE=time
markup=none

[shutdown]
interval=once
markup=none

# vim:ft=dosini
