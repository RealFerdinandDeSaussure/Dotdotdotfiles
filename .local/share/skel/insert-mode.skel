# %-LOCATION:$HOME/.config/sway/scripts/insert-mode-% -*-sh-*-
# %-VARIABLE:INFO=(pass show random/persönliche_informationen)-% -*-sh-*-
#!/bin/bash
# DO EDITS HERE: $HOME/.local/share/skel/insert-mode.skel
function dotool {
    local tool
    local args

    if [[ -n "$WAYLAND_DISPLAY" ]]; then
        tool=wtype
        case $1 in
            type)
                args=("${@:2}")
                ;;
            keyup)
                args=("-p" "${@:2}")
                ;;
        esac
    else
        tool=xdotool
        args=("${@}")
    fi

    if ! command -v "$tool" >/dev/null 2>&1; then
        notify-send "No suitable input application found."
        exit 1
    fi

    $tool "${args[@]}"
}

function translate_char {
    case $1 in
        M)
            echo -n "{{{(string match -rg '^Email2:\s+(.+)' $INFO)}}}"
            ;;
        m)
            echo -n "{{{(string match -rg '^Email:\s+(.+)' $INFO)}}}"
            ;;
        N)
            echo -n "{{{(string match -rg '^Vollname:\s+(.+)' $INFO)}}}"
            ;;
        n)
            echo -n "{{{(string match -rg '^Nachname:\s+(.+)' $INFO)}}}"
            ;;
        v)
            echo -n "{{{(string match -rg '^Vorname:\s+(.+)' $INFO)}}}"
            ;;
        s)
            echo -n "{{{(string match -rg '^Straße:\s+(.+)' $INFO)}}}"
            ;;
        p)
            echo -n "{{{(string match -rg '^PLZ:\s+(.+)' $INFO)}}}"
            ;;
        o)
            echo -n "{{{(string match -rg '^Ort:\s+(.+)' $INFO)}}}"
            ;;
        f)
            echo -n "{{{(string match -rg '^Tel\.:\s+(.+)' $INFO)}}}"
            ;;
    esac
}

function insert_text {
    dotool keyup "$1"
    dotool type "$(translate_char "$1")"
}

insert_text "$1"
