/* %-LOCATION:$HOME/.config/ironbar/style.css-% -*-css-*- */
@define-color base00 #{{{$__BASE00}}};
@define-color base01 #{{{$__BASE01}}};
@define-color base02 #{{{$__BASE02}}};
@define-color base03 #{{{$__BASE03}}};
@define-color base04 #{{{$__BASE04}}};
@define-color base05 #{{{$__BASE05}}};
@define-color base06 #{{{$__BASE06}}};
@define-color base07 #{{{$__BASE07}}};
@define-color base08 #{{{$__BASE08}}};
@define-color base09 #{{{$__BASE09}}};
@define-color base0a #{{{$__BASE0A}}};
@define-color base0b #{{{$__BASE0B}}};
@define-color base0c #{{{$__BASE0C}}};
@define-color base0d #{{{$__BASE0D}}};
@define-color base0e #{{{$__BASE0E}}};
@define-color base0f #{{{$__BASE0F}}};

:root {
    --wh-size: 4px;
    --wh-alpha: 0.55;
    --widget-pad-horiz: 0.65em;
    --bar-pad-vert: 0.14em;
    --popup-pad-vert: 0.4em;
    --popup-pad-horiz: 0.6em;
    --base00-rgb: 50,48,47;
    --base01-rgb: 60,56,54;
    --base02-rgb: 80,73,69;
    --base03-rgb: 102,92,84;
    --base04-rgb: 189,174,147;
    --base05-rgb: 213,196,161;
    --base06-rgb: 235,219,178;
    --base07-rgb: 251,241,199;
    --base08-rgb: 251,73,52;
    --base09-rgb: 254,128,25;
    --base0a-rgb: 250,189,47;
    --base0b-rgb: 184,187,38;
    --base0c-rgb: 142,192,124;
    --base0d-rgb: 131,165,152;
    --base0e-rgb: 211,134,155;
    --base0f-rgb: 214,93,14;
}

* {
    border: none;
    border-radius: 0;
    margin: 0;
    background-image: none;
    font-family: sans-serif, "FontAwesome";
    font-size: 12pt;
    padding: 0;
    transition: none;
    border-color: transparent;
    border-style: solid;
    box-shadow: none;
}

.background {
    background: transparent;
}

#bar {
    background: linear-gradient(to right, rgba(var(--base02-rgb),.8), rgba(var(--base00-rgb),.9) 33%, rgba(var(--base01-rgb),.9));
    color: @base06;
}

.widget {
    padding-bottom: var(--bar-pad-vert);
    padding-top: var(--bar-pad-vert);
    color: inherit;
}

.widget-box {
    padding: 0;
}

button {
    color: inherit;
}

#bar #end revealer .widget {
    padding-left: var(--widget-pad-horiz);
    padding-right: var(--widget-pad-horiz);
    margin-left: 0.2em;
    margin-right: 0.2em;
}

#bar #end .widget:hover {
    background-position: left;
    color: @base00;
}

#bar #end revealer:nth-child(odd) > .widget {
    background:
        right
        no-repeat
        linear-gradient(to right,
                        rgba(var(--base0c-rgb),var(--wh-alpha)) calc(50% + var(--wh-size)),
                        transparent calc(50% + var(--wh-size)));
    background-size: 200% 1.2em;
    transition: color 500ms ease, background-size 200ms ease, background-position 300ms ease;
}

#bar #end revealer:nth-child(odd) .widget:hover {
    background:
        right
        no-repeat
        linear-gradient(to right,
                        rgba(var(--base0c-rgb),1) calc(50% + var(--wh-size)),
                        transparent calc(50% + var(--wh-size)));
    background-position: left;
    background-size: 200% 100%;
    color: @base00;
}

#bar #end revealer:nth-child(even) > .widget {
    background:
        right
        no-repeat
        linear-gradient(to right,
                        rgba(var(--base0d-rgb),var(--wh-alpha)) calc(50% + var(--wh-size)),
                        transparent calc(50% + var(--wh-size)));
    background-size: 200% 1.2em;
    transition: color 500ms ease, background-size 200ms ease, background-position 300ms ease;
}

#bar #end revealer:nth-child(even) .widget:hover {
    background:
        right
        no-repeat
        linear-gradient(to right,
                        rgba(var(--base0d-rgb),1) calc(50% + var(--wh-size)),
                        transparent calc(50% + var(--wh-size)));
    background-position: left;
    background-size: 200% 100%;
    color: @base00;
}

#bar #end revealer:nth-child(odd) .popup {
    padding: var(--popup-pad-vert) var(--popup-pad-horiz);
    background: radial-gradient(circle at 80% 120%, @base0c, @base03 70%, @base01);
    color: @base07;
}

#bar #end revealer:nth-child(even) .popup {
    padding: var(--popup-pad-vert) var(--popup-pad-horiz);
    background: radial-gradient(circle at 80% 120%, @base0d, @base03 70%, @base01);
    color: @base07;
}

.popup-button {
    padding: 0;
    border: 0.2em solid transparent;
    border-radius: 0.2em;
    transition-property: background, border;
    transition-duration: 200ms;
    transition-timing-function: ease;
}

.popup-button:hover {
    border: 0.2em solid @base01;
    background: @base01;
}

/* Styling of individual widgets and their popups */

.bindmode {
    color: @base00;
    padding-left: 2em;
    padding-right: 2em;
    background: linear-gradient(to right, transparent, @base0a 2em, @base0a calc(100% - 2em), transparent);
}

#clipboard-contents {
    font-size: 0.8em;
    vertical-align: bottom;
}

.clipboard-popup {
    min-width: 300px;
    max-width: 500px;
}

.focused .label {
    font-weight: 700;
    font-stretch: expanded;
}

.popup-music .title .label {
    font-weight: 700;
    font-size: 1.3em;
}

.popup-music .album .label { font-style: italic; }
.popup-music * .icon-box {
    margin-right: 0.2em;
    min-width: 1.4rem;
    max-width: 1.4rem;
}

.popup-clock .calendar-clock {
    font-size: 1.5em;
    font-weight: 700;
}

.popup-clock .calendar {
    background-color: transparent;
    color: @base07;
}

.popup-clock .calendar header button {
    font-size: 1.2em;
    color: @base07;
}

.popup-clock .calendar header label {
    font-style: italic;
}

.popup-clock .calendar .day-name {
    font-weight: 700;
}

.popup-clock .calendar .today {
    background: @base0d;
    color: @base07;
}

.popup-clock .calendar .other-month {
    color: rgba(var(--base07-rgb),0.6);
}

.workspaces {
    margin: 0;
    padding: 0;
    border-width: 0;
    background: linear-gradient(to right, @base02, @base00);
}

#dummy-widget-gradient {
    color: transparent;
    border: 0;
    margin: 0;
    padding-right: 4em;
    background: linear-gradient(to right, @base00, transparent);
}

.workspaces .item {
    padding: var(--bar-pad-vert) 0.40em;
    transition: color 400ms ease, background 300ms ease;
}

.workspaces .item.focused {
    color: @base00;
    background: @base0d;
}

.workspaces .item.urgent {
    color: @base00;
    background: @base08;
}
