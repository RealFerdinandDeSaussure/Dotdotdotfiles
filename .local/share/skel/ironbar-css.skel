/* %-LOCATION:$HOME/.config/ironbar/style.css-% -*-css-*- */
@define-color base00 #{{{$__BASE00}}};
@define-color base01 #{{{$__BASE01}}};
@define-color base02 #{{{$__BASE02}}};
@define-color base03 #{{{$__BASE03}}};
@define-color base04 #{{{$__BASE04}}};
@define-color base05 #{{{$__BASE05}}};
@define-color base06 #{{{$__BASE06}}};
@define-color base07 #{{{$__BASE07}}};
@define-color base08 #{{{$__BASE08}}};
@define-color base09 #{{{$__BASE09}}};
@define-color base0a #{{{$__BASE0A}}};
@define-color base0b #{{{$__BASE0B}}};
@define-color base0c #{{{$__BASE0C}}};
@define-color base0d #{{{$__BASE0D}}};
@define-color base0e #{{{$__BASE0E}}};
@define-color base0f #{{{$__BASE0F}}};

:root {
    --start-color: @base0e;
    --end-color: @base0d;
    --sec-bw: 0.18rem; /* section border width */
    --bar-pad-vert: 0.15rem;
    --button-pad-vert: 0.28em;
    --button-pad-horiz: 0.38em;
    --popup-pad-vert: 0.5em;
    --popup-pad-horiz: 1em;
    --widget-pad-horiz: 0.65em;
    --bar-gap-bottom: 8px;
    --bar-gap-top: 4px;
    --base00-rgb: {{{(hex2rgb $__BASE00)}}};
    --base01-rgb: {{{(hex2rgb $__BASE01)}}};
    --base02-rgb: {{{(hex2rgb $__BASE02)}}};
    --base03-rgb: {{{(hex2rgb $__BASE03)}}};
    --base04-rgb: {{{(hex2rgb $__BASE04)}}};
    --base05-rgb: {{{(hex2rgb $__BASE05)}}};
    --base06-rgb: {{{(hex2rgb $__BASE06)}}};
    --base07-rgb: {{{(hex2rgb $__BASE07)}}};
    --base08-rgb: {{{(hex2rgb $__BASE08)}}};
    --base09-rgb: {{{(hex2rgb $__BASE09)}}};
    --base0a-rgb: {{{(hex2rgb $__BASE0A)}}};
    --base0b-rgb: {{{(hex2rgb $__BASE0B)}}};
    --base0c-rgb: {{{(hex2rgb $__BASE0C)}}};
    --base0d-rgb: {{{(hex2rgb $__BASE0D)}}};
    --base0e-rgb: {{{(hex2rgb $__BASE0E)}}};
    --base0f-rgb: {{{(hex2rgb $__BASE0F)}}};
}

/* base styling */
* {
    border: none;
    border-radius: 0;
    margin: 0;
    background-color: transparent;
    font-family: sans-serif, "FontAwesome";
    font-size: 1.05rem;
    padding: 0;
    transition: none;
    border-color: transparent;
    border-style: solid;
    box-shadow: none;
}

.background {
    background: transparent;
}

#bar {
    color: @base06;
}

button {
    color: inherit;
}

#bar > * {
    margin-top: var(--bar-gap-top);
    margin-bottom: var(--bar-gap-bottom);
}

#bar #end {
    border-radius: 1rem 0 0 1rem;
    border-width: var(--sec-bw) 0 var(--sec-bw) var(--sec-bw);
    border-color: var(--end-color);
}

#start-bar {
    background-color: var(--start-color); /* this closes the gap between border and content */
    border-radius: 0 1rem 1rem 0;
    border-width: var(--sec-bw) var(--sec-bw) var(--sec-bw) 0;
    border-color: var(--start-color);
}

#bar #end > revealer:first-child > .widget {
    border-radius: 1rem 0 0 1rem;
    border-left-width: 0;
    padding-left: 2em;
}

#start-bar > revealer:last-child > .widget {
    border-radius: 0 1rem 1rem 0;
    border-right-width: 0;
    padding-right: 1em;
}

#bar #end > revealer > .widget {
    /* the widgets in the start section take the full height of the section, so */
    /* their padding-top and -bottom values should be zero */
    padding-top: var(--bar-pad-vert);
    padding-bottom: var(--bar-pad-vert);
    background: rgba(var(--base01-rgb), .8);
    color: inherit;
    border-top: 0px;
    border-bottom: 0px;
    border-left-color: @base03;
    border-left-width: 0.1em;
    padding-left: var(--widget-pad-horiz);
    padding-right: var(--widget-pad-horiz);
    transition-property: color, background-color;
    transition-duration: 300ms;
    transition-timing-function: ease;
}

#bar #end > revealer > .widget:hover {
    background-color: var(--end-color);
    color: @base00;
}

/* tool tip styling */
tooltip box, .widget .menu contents {
    border-radius: 4px;
    padding: var(--popup-pad-vert) var(--popup-pad-horiz);
    background-color: @base02;
    color: @base06;
}

/* context menu styling, mainly relevant for the tray widget, some additional
   styling further below together with popup styls */
.widget .menu {
    background-color: transparent;
}

.widget .menu radio:checked {
    color: @base00;
}

.widget .menu separator {
    background-color: @base04;
}

#start-bar > revealer .menu arrow {
    background: linear-gradient(to bottom, var(--start-color), @base03 13px);
}

#bar #end > revealer .menu arrow {
    background: linear-gradient(to bottom, var(--end-color), @base03 13px);
}

/* popup styling */
.popup {
    border-radius: 4px;
}

/* this prevents visible background behind a popup's rounded corners */
contents {
    background-color: transparent;
}

/* both popups should match the main color of the start and end sections */
#bar #end > revealer .popup,
#bar #end > revealer .menu contents {
    padding: var(--popup-pad-vert) var(--popup-pad-horiz);
    background: radial-gradient(circle at 80% 120%, var(--end-color), @base03 70%, @base01);
    color: @base07;
}

#start-bar > revealer .popup,
#start-bar > revealer .menu contents {
    padding: var(--popup-pad-vert) var(--popup-pad-horiz);
    background: radial-gradient(circle at 80% 120%, var(--start-color), @base03 70%, @base01);
    color: @base07;
}

/* styling for buttons on both popups and context menus */
.popup .text-button,
.popup .image-button,
.menu modelbutton {
    padding-top: var(--button-pad-vert);
    padding-bottom: var(--button-pad-vert);
    border-radius: 4px;
    transition: background, color;
    transition-duration: 200ms;
    transition-timing-function: ease;
    color: @base05;
}

.menu modelbutton > label {
    padding-left: var(--button-pad-horiz);
    padding-right: var(--button-pad-horiz);
}

.popup .text-button:hover,
.popup .image-button:hover,
.menu modelbutton:hover {
    color: @base07;
    font-weight: 700;
}

.menu modelbutton:focus {
    background-color: transparent;
}

#bar #end > revealer .popup .text-button:hover,
#bar #end > revealer .popup .image-button:hover,
#bar #end > revealer .menu modelbutton:hover {
    background: var(--end-color);
}

#start-bar > revealer .popup .text-button:hover,
#start-bar > revealer .popup .image-button:hover,
#start-bar > revealer .menu modelbutton:hover {
    background: var(--start-color);
}

/* ---------------------------------------------- */
/* Styling of individual widgets and their popups */
#power {
    background: linear-gradient(to right, @base00, @base01);
    padding-left: var(--widget-pad-horiz);
    padding-right: var(--widget-pad-horiz);
    transition: background 300ms ease;
}

#power:hover {
    background: linear-gradient(to right, var(--start-color) 90%, @base01);
}

.bindmode {
    color: @base00;
    padding-left: 2em;
    padding-right: 2em;
    background: linear-gradient(to right, @base01, @base0a 2em, @base0a calc(100% - 2em), @base01);
}

.clipboard-popup {
    min-width: 300px;
}

#focused {
    margin-left: 0.5em;
    margin-right: 1.5em;
    padding: var(--bar-pad-vert) var(--widget-pad-horiz) var(--bar-pad-vert) var(--widget-pad-horiz);
}

#focused .label {
    font-weight: 700;
    text-shadow: @base02 0.1em 0.15em 3px;
    font-stretch: expanded;
}

.popup-music {
    min-width: 25rem;
    max-width: 30rem;
}

.popup-music .title .label {
    font-weight: 700;
    font-size: 1.3em;
}

.popup-music .album .label { font-style: italic; }
.popup-music * .icon-box {
    margin-right: 1em;
    min-width: 1.4rem;
    max-width: 1.4rem;
}

.popup-music .controls button {
    margin: 0.2em 0.6em;
    padding: 0.2em 0.8em;
    color: @base00;
}

.popup-music .volume .icon {
    color: @base00;
}

.popup-music .volume .slider trough {
    background: linear-gradient(to top, @base06 40%, rgba(var(--base06-rgb), 0.1) 95%);
    border-radius: 6px 6px 0px 0px;
}

.popup-music .progress .label {
    color: @base00;
}

.popup-music .progress .slider trough {
    background: linear-gradient(to right, @base06 40%, rgba(var(--base06-rgb), 0.1) 95%);
    border-radius: 0px 6px 6px 0px;
}

#bar #end > revealer .popup-music .volume .slider trough highlight {
    background: linear-gradient(to top,
                                rgba(var(--base0d-rgb),1) 50%,
                                rgba(var(--base07-rgb),1));
}

#bar #end > revealer .popup-music .progress .slider trough highlight {
    background: linear-gradient(to right,
                                rgba(var(--base0d-rgb),1) 50%,
                                rgba(var(--base07-rgb),1));
}

.popup-clock .calendar-clock {
    border: solid;
    font-size: 2em;
    font-weight: 700;
}

.popup-clock .calendar {
    background-color: transparent;
    color: @base07;
}

.popup-clock .calendar header button {
    font-size: 1.2em;
    color: @base07;
}

.popup-clock .calendar header button {
    font-size: 1.2em;
    color: @base07;
}

.popup-clock .calendar header label {
    font-style: italic;
}

.popup-clock .calendar .day-name {
    font-weight: 700;
}

.popup-clock .calendar .day-number.today,
.popup-clock .calendar .day-number.today:selected {
    background: @base0b;
    color: @base07;
}

.popup-clock .calendar .day-number:selected {
    background-color: rgba(var(--base0e-rgb),0.6);
    outline-color: rgba(var(--base0e-rgb),0.6);
}

.popup-clock .calendar .day-number:focus {
    background: transparent;
    outline-color: var(--start-color);
}

.popup-clock .calendar .day-number:selected:focus {
    background-color: var(--start-color);
    outline-color: var(--start-color);
    color: inherit;
}

.popup-clock .calendar .other-month {
    color: rgba(var(--base07-rgb),0.6);
}

.power-button.image-button {
    border: 4px solid @base00;
    margin-right: 1.5em;
    padding: 0.5em;
    border-radius: 1em;
}

#popup-power box revealer:last-child .power-button {
    margin-right: 0;
}

revealer .popup .power-button.image-button:hover {
    background-color: @base00;
}

.tray .item {
    margin-right: var(--widget-pad-horiz);
}

.tray .item:last-child {
    margin-right: 0;
}

#start-bar > revealer > .workspaces {
    background: @base01;
}

.workspaces .item {
    min-width: 1.2em;
    padding-left: 0.65rem;
    padding-right: 0.65rem;
    transition: color 400ms ease, background 300ms ease;
    border-radius: 0 1rem 1rem 0;
    background: linear-gradient(to right, @base01, @base03);
}

.workspaces .item.focused {
    font-weight: 700;
    color: @base07;
    background: linear-gradient(to right, @base01, var(--start-color) 35%);
}

.workspaces .item:not(.focused):hover {
    background: linear-gradient(to right, @base01, var(--start-color) 35%);
    color: @base03;
}

.workspaces .item.urgent {
    color: @base00;
    background: linear-gradient(to right, @base01, @base08 35%);
}
