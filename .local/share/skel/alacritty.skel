# %-LOCATION:$HOME/.config/alacritty/default.toml-% -*-conf-toml-*-
# DO EDITS HERE: $HOME/.local/share/skel/alacritty.skel
[colors]
indexed_colors = []

[colors.normal]
black = "#{{{__BASE00}}}"
blue = "#{{{__BASE0D}}}"
cyan = "#{{{__BASE0C}}}"
green = "#{{{__BASE0B}}}"
magenta = "#{{{__BASE0E}}}"
red = "#{{{__BASE08}}}"
white = "#{{{__BASE06}}}"
yellow = "#{{{__BASE0A}}}"

[colors.bright]
black = "#{{{__BASE02}}}"
blue = "#{{{__BASE04}}}"
cyan = "#{{{__BASE03}}}"
green = "#{{{__BASE05}}}"
magenta = "#{{{__BASE01}}}"
red = "#{{{__BASE0F}}}"
white = "#{{{__BASE07}}}"
yellow = "#{{{__BASE09}}}"

[colors.cursor]
cursor = "#ebdbb2"
text = "#32302f"

[colors.hints.end]
background = "#d5c4a1"
foreground = "#32302f"

[colors.hints.start]
background = "#d5c4a1"
foreground = "#32302f"

[colors.primary]
background = "#32302f"
foreground = "#d5c4a1"

[colors.vi_mode_cursor]
cursor = "#ebdbb2"
text = "#32302f"

[cursor]
unfocused_hollow = false
vi_mode_style = "Block"

[cursor.style]
blinking = "Never"
shape = "Underline"

[font.bold]
style = "Bold"

[font.normal]
family = "{{{FONT_TERMINAL}}}"

[hints]
alphabet = "jfkdlsöaurieowpq"

[[hints.enabled]]
command = "xdg-open"
post_processing = true
regex = "(mailto:|gemini:|gopher:|https:|http:|news:|file:|git:|ssh:|ftp:)[^\u0000-\u001F\u007F-<>\"\\s{-}\\^⟨⟩`]+"

[hints.enabled.binding]
key = "L"
mods = "Control"

[[keyboard.bindings]]
action = "ScrollPageUp"
key = "P"
mode = "~Alt"
mods = "Shift|Control|Alt"

[[keyboard.bindings]]
action = "ScrollPageDown"
key = "N"
mode = "~Alt"
mods = "Shift|Control|Alt"

[[keyboard.bindings]]
action = "ScrollLineUp"
key = "P"
mode = "~Alt"
mods = "Shift|Control"

[[keyboard.bindings]]
action = "ScrollLineDown"
key = "N"
mode = "~Alt"
mods = "Shift|Control"

[window]
opacity = 0.92