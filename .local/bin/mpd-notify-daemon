#!/usr/bin/env python

import json
import os
import subprocess
import sys
from typing import Optional

import dbus
from dbus.mainloop.glib import DBusGMainLoop
from gi.repository import GLib
from mpd import CommandError, MPDClient
from typing_extensions import TypedDict

ARTFILE = os.path.join(os.getenv("HOME"), ".cache", "mpdnotdaem-art")


class Song(TypedDict):
    file: str
    cover: str
    title: str
    artist: str
    album: str
    lyrics: str


def song_to_notification_args(song: Song) -> tuple:
    """Turn song into a tuple that can be used as args to notify-send."""
    return (
        song["title"],
        "{artist}<br/><i>{album}</i><br/><br/>".format(**song),
    )


def run_dunstify(args: list):
    subprocess.run(
        ["dunstify", "-h", "string:category:desktop.mpd", "-r", "999", *args],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )


def notify_song(mpc: MPDClient, song: Song):
    """Create notification with information contained in SONG."""
    if not song:
        return

    album_art = get_album_art(mpc, song)
    args = []
    if album_art:
        write_album_art(album_art)
        args += ["-i", ARTFILE]

    args += ["--", *song_to_notification_args(song)]
    run_dunstify(args)


def write_album_art(album_art: bytes):
    """Write album art from song to ARTFILE. Return True if succesful."""
    with open(ARTFILE, mode="wb") as f:
        f.write(album_art)
        return True


def get_album_art(mpc: MPDClient, song: Song) -> Optional[bytes]:
    try:
        pic = mpc.readpicture(song["file"])
        return pic["binary"]
    except CommandError:
        return None


def mpd_idle_loop(mpc: MPDClient, current_song: Song):
    while True:
        mpc.idle("player")
        new_song = mpc.currentsong()
        if new_song != current_song:
            current_song = new_song
            notify_song(mpc, current_song)


def on_job_removed(job_id: int, job_path: str, unit: str, result: str):
    if unit == "mpd.service" and result == "done":
        unit_obj = bus.get_object(
            "org.freedesktop.systemd1", manager.GetUnit("mpd.service")
        )
        state = unit_obj.Get(
            "org.freedesktop.systemd1.Unit",
            "ActiveState",
            dbus_interface="org.freedesktop.DBus.Properties",
        )
        if state == "active":
            loop.quit()


if __name__ == "__main__":
    DBusGMainLoop(set_as_default=True)
    bus = dbus.SessionBus()
    systemd = bus.get_object("org.freedesktop.systemd1", "/org/freedesktop/systemd1")
    manager = dbus.Interface(systemd, "org.freedesktop.systemd1.Manager")
    loop = GLib.MainLoop()

    # Set up signal handler just once
    bus.add_signal_receiver(
        on_job_removed,
        signal_name="JobRemoved",
        dbus_interface="org.freedesktop.systemd1.Manager",
        bus_name="org.freedesktop.systemd1",
    )

    try:
        mpc = MPDClient()
        while True:
            # Check if MPD is already active
            try:
                unit_path = manager.GetUnit("mpd.service")
                unit_obj = bus.get_object("org.freedesktop.systemd1", unit_path)
                state = unit_obj.Get(
                    "org.freedesktop.systemd1.Unit",
                    "ActiveState",
                    dbus_interface="org.freedesktop.DBus.Properties",
                )
                if state != "active":
                    # wait for mpd to become active
                    loop.run()
            except dbus.exceptions.DBusException:
                # wait for mpd to become active
                loop.run()

            try:
                mpc.connect("localhost", port=6600)
                current_song = mpc.currentsong()
                mpd_idle_loop(mpc, current_song)
            except (ConnectionRefusedError, ConnectionError):
                # If connection fails, wait for service to restart
                continue

    except KeyboardInterrupt:
        sys.exit(0)
