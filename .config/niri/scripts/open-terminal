#!/bin/sh

test -z "$TERMINAL" && exit 1

win="$(niri msg -j focused-window)"
id="$(echo -n "$win" | jq -r '.app_id')"
pos="$(echo -n "$win" | jq -r '.layout.pos_in_scrolling_layout[1]')"

niri msg action spawn -- $TERMINAL
    
if [[ "$id" = "$TERMINAL" && "$pos" -lt 2 ]]; then
    niri msg action consume-or-expel-window-left
fi
    
