# -*- conf -*-
# This is a list of Arch Linux packages required for the current configuration
# to run properly. The fish function arch-pkg-reqs will git grep the Dotfiles
# for every line in this file and offer to remove packages for which no matches
# have been found.

# To separate package names and search terms, separate them with a colon.
# Multiple search terms can be separated by commas (leading and trailing
# whitespace will be stripped).
# <pkg-name>:<search-term1,search-term2,...>

fcitx5:fcitx
foot
fzf
gcr:pinentry-gnome3
gnu-free-fonts:FreeSans
ironbar
isync:mbsync
jq
mako:makoctl
mpd
mu:mu4e
niri
noto-fonts-cjk:Noto Sans CJK
otf-font-awesome-4:FontAwesome
pass
python-dbus:dbus.mainloop.glib
python-gobject:gi.repository
python-mpd2:MPDClient
rmpc
swaybg
swayidle
tofi:dmenu
ttc-iosevka:Iosevka
ttf-fraunces-variable:Fraunces
ttf-nerd-fonts-symbols:Symbols Nerd Font
wl-clipboard:wl-copy
wlr-which-key
wtype
